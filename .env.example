# =============================================================================
# ZYE AI — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# =============================================================================

# --- Primary AI Provider ---
GEMINI_API_KEY=your_gemini_api_key_here

# --- Gemini Multi-Project Key Slots (7 Independent Slots) ---
GEMINI_API_KEY_01=
GEMINI_API_KEY_02=
GEMINI_API_KEY_03=
GEMINI_API_KEY_04=
GEMINI_API_KEY_05=
GEMINI_API_KEY_06=
GEMINI_API_KEY_07=

# --- Gemini Multi-Project Google Cloud Project IDs (7 Slots) ---
GEMINI_PROJECT_ID_01=
GEMINI_PROJECT_ID_02=
GEMINI_PROJECT_ID_03=
GEMINI_PROJECT_ID_04=
GEMINI_PROJECT_ID_05=
GEMINI_PROJECT_ID_06=
GEMINI_PROJECT_ID_07=

# --- Optional Cloud AI Providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Local AI (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Personal Assistant & Email Integration (Day 14) ---
ZYE_EMAIL_ADDRESS=
ZYE_EMAIL_APP_PASSWORD=
ZYE_IMAP_HOST=imap.gmail.com
ZYE_SMTP_HOST=smtp.gmail.com
ZYE_TIMEZONE=Asia/Kolkata

# --- Future Smart Home Integration ---
SMART_HOME_MODE=standby
HA_URL=http://homeassistant.local:8123
HA_TOKEN=


# --- Multi-AI Plugin Hub (Day 25) ---
PERPLEXITY_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
