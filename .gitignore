# =============================================================================
# ZYE AI — Git Ignore Rules
# =============================================================================

# --- Secrets and credentials ---
.env
.env.*
!.env.example
Gemini Api Keys.txt
*.key
*.pem
spotify-config.json
*spotify*.json

# --- Python virtual environment ---
.venv/

# --- Python bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Log files ---
logs/*.log
logs/*.json

# --- Database files ---
data/*.sqlite
data/*.sqlite3
data/*.db

# --- Browser profiles (sensitive session data) ---
profiles/*
!profiles/.gitkeep

# --- Backup files ---
backups/*
!backups/.gitkeep

# --- Preserve directory structure ---
!logs/.gitkeep
!data/cad_models/.gitkeep

# --- Generated CAD/Engineering files ---
data/cad_models/*.stl
data/cad_models/*.dxf
data/cad_models/*.step
data/cad_models/*.iges
data/cad_models/*.obj

# --- Temporary files ---
*.tmp
*.temp
*.swp
*~

# --- IDE files ---
.idea/
.vscode/
*.suo
*.user
*.sln.docstates

# --- OS files ---
Thumbs.db
desktop.ini
.DS_Store

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg
